{
  "//": "Merge this into your Claude Code settings.json (project .claude/settings.json or ~/.claude/settings.json). The same script handles every event; it derives the lifecycle type from hook_event_name.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/absolute/path/to/agent-activity-dashboard/hooks/hook.js\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/absolute/path/to/agent-activity-dashboard/hooks/hook.js\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/absolute/path/to/agent-activity-dashboard/hooks/hook.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/absolute/path/to/agent-activity-dashboard/hooks/hook.js\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/absolute/path/to/agent-activity-dashboard/hooks/hook.js\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/absolute/path/to/agent-activity-dashboard/hooks/hook.js\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/absolute/path/to/agent-activity-dashboard/hooks/hook.js\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/absolute/path/to/agent-activity-dashboard/hooks/hook.js\""
          }
        ]
      }
    ]
  }
}
