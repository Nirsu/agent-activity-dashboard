# Copy to .env. Configure the Brain services below before using live memory.

# Server
PORT=4318
HOST=0.0.0.0

# Local PostgreSQL: npm run db:start creates .env.postgres.local with random
# credentials. The server loads it after .env; existing variables take priority.
# See POSTGRES.md for explicit SQLite imports and rollback.
# DATABASE_URL=postgresql://user:password@127.0.0.1:55432/harmonie
# Leave DATABASE_URL empty explicitly to retain SQLite compatibility.

# Optional version-controlled-by-operator price catalogue, USD / million tokens.
# No built-in tariffs: an unconfigured model has an unknown cost, never $0.
# Use exact model IDs, current contracted rates, and record the effective date.
# MODEL_PRICING_JSON={"your-model":{"inputPerMillionUsd":1,"outputPerMillionUsd":4,"cachedInputPerMillionUsd":0.1}}
# Values above are examples only. Estimated API-equivalent usage is not an
# invoice, nor an allocation of Codex/Claude subscription costs.

# Harmony Brain server. All credentials remain server-side.
# Shared non-secret limits and timings: server/src/brain/config.json.
# BRAIN_DB_PATH=/path/to/brain.db
# BRAIN_PROJECTS_PATH=brain.projects.json
# Legacy local registrations are imported once; manage new GitHub projects in Projects.
# GitHub read-only code acquisition for projects created in Projects. Public repos
# work without a token. For private repos use a fine-grained token limited to the
# selected repositories with Contents: read. Never put this token in Git URLs.
# BRAIN_GITHUB_TOKEN=
# Optional cache location; defaults to DATA_DIR/brain-repositories.
# BRAIN_GITHUB_CACHE_PATH=/path/to/brain-repositories
# BRAIN_UI_PORT=5173
# Model access for real analyses and Cognee indexing; billing must be enabled.
# BRAIN_MODEL=gpt-5.6-luna
# OPENAI_API_KEY=
# Maximum duration per model call. 0 disables the response deadline for the pilot.
# Positive values must be between 1000 and 1800000 ms.
# BRAIN_REQUEST_TIMEOUT_MS=0

# Durable Notion OAuth. Use the HTTPS public callback on a deployed server.
# BRAIN_NOTION_REDIRECT_URL=http://127.0.0.1:4318/api/brain/connections/notion/callback

# Private Cognee service. Change both the port and URL if 8000 is occupied.
# COGNEE_API_URL=http://127.0.0.1:8000
# COGNEE_PORT=8000
# COGNEE_USERNAME=brain@example.com
# COGNEE_PASSWORD=<generated-service-password>
# COGNEE_JWT_SECRET=<different-generated-secret>
# Optional pre-provisioned bearer token instead of password login:
# COGNEE_API_TOKEN=
# Leave COGNEE_LLM_MODEL unset to use openai/ followed by BRAIN_MODEL.
# COGNEE_LLM_MODEL=openai/gpt-5.6-luna
# COGNEE_EMBEDDING_MODEL=openai/text-embedding-3-small
# COGNEE_EMBEDDING_DIMENSIONS=1536
# COGNEE_CPUS=2
# COGNEE_MEMORY_LIMIT=4g

# Docker: browser and administrator tokens are required, including the local
# container setup. Native localhost development can leave both unset.
# Issue agent workstation tokens from Accounts after connecting the browser.
# GitHub project caches use the existing persistent server data volume.
# Optional legacy checkout for the Brain stack:
# BRAIN_REPO_MOUNT=.
# VIEWER_TOKEN=<generated-browser-viewer-token>
# BRAIN_ADMIN_TOKEN=<different-generated-administrator-token>

# Synchronization: poll by default; webhook retains periodic reconciliation.
# Webhooks require separate provider setup and public HTTPS callback routes.
# BRAIN_SYNC_MODE=poll
# BRAIN_SYNC_ENABLED=0
# Set to 0 only for a preview without automatic memory synchronization.
# BRAIN_GITHUB_WEBHOOK_SECRET=
# BRAIN_GITHUB_WEBHOOK_PROJECTS={"your-org/your-repository":["dashboard"]}
# BRAIN_NOTION_WEBHOOK_VERIFICATION_TOKEN=

# Development-agent client only. Issue a workstation token in Accounts, then
# provide it to the clients and relay environment, including for localhost.
# BRAIN_URL=https://brain.example.com
# HARMONIE_TOKEN=<issued-workstation-token>

# Ring buffer size (events kept in memory)
RING_SIZE=500

# Session goes idle after this many ms with no activity (fallback when the
# Stop hook is not installed).
IDLE_MS=45000
# Session expires after this interval without events from it or a descendant.
SESSION_TTL_MS=1800000
# Optional same-machine Codex origin lookup (read-only; no conversation content).
# CODEX_METADATA_DB=C:/Users/you/.codex/state_5.sqlite

# Detailed privacy-safe history retention (rolling days)
# 190 days allows comparison of two 90-day periods; existing shorter overrides remain valid.
RETENTION_DAYS=190

# Encrypt Notion OAuth credentials in persistent storage.
# Generate at least 32 characters. Back up the key separately from the data.
# Changing it cannot decrypt existing credentials; restore it or reconnect.
CREDENTIAL_ENCRYPTION_KEY=

# --- Jira ticket-title resolution (optional; key-only fallback if unset) ---
# JIRA_BASE_URL=https://your-org.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=xxxxxxxx
