# Copy to .env (server reads it). All optional — sane defaults apply.

# Server
PORT=4318
HOST=0.0.0.0

# Harmony Brain: optional local paths; defaults resolve from the application.
# Shared non-secret limits and timings: server/src/brain/config.json.
# BRAIN_REPO_PATH=/path/to/repository
# BRAIN_NOTION_PATH=/path/to/notion-exports
# BRAIN_UI_PORT=5173
# AI analyses (separate from the fixed demo). Keep secrets on the server only.
# BRAIN_PROJECTS_PATH=brain.projects.json
# BRAIN_MODEL=model-id-available-in-your-api-project
# Maximum duration per model call (default 5 minutes; 0 disables the deadline).
# Positive values must be between 1000 and 1800000 ms.
# BRAIN_REQUEST_TIMEOUT_MS=300000
# OPENAI_API_KEY=
# Docker Brain overlay (compose.brain.yaml): host paths for read-only mounts.
# BRAIN_REPO_MOUNT=.
# BRAIN_NOTION_MOUNT=../save_notion
# VIEWER_TOKEN=set-a-random-token-before-using-the-Brain-Docker-overlay

# Ring buffer size (events kept in memory)
RING_SIZE=500

# Session goes idle after this many ms with no activity (fallback when the
# Stop hook is not installed).
IDLE_MS=45000
# Session card is evicted this many ms after its last event.
SESSION_TTL_MS=1800000

# Detailed privacy-safe history retention (rolling days)
RETENTION_DAYS=60

# Encrypt GitHub/Jira delivery credentials stored in the Docker data volume.
# Required before saving delivery settings from the dashboard.
CREDENTIAL_ENCRYPTION_KEY=change-me-before-sharing

# --- Jira ticket-title resolution (optional; key-only fallback if unset) ---
# JIRA_BASE_URL=https://your-org.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=xxxxxxxx
